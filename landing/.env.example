# Backend API base URL (no trailing slash). Production: https://vpnapi.mydayai.uz
BACKEND_API_URL=https://vpnapi.mydayai.uz

# Shared secret with the Go backend's admin write handlers for /api/revalidate-pricing (D-14).
# Backend will POST landing/api/revalidate-pricing?secret=<this>; landing constant-time-compares.
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=replace-me-32-bytes-base64

# Cookie scope. Leave empty in dev to get host-only cookies. In production set to "risevpn.com".
COOKIE_DOMAIN=

# Standard Next.js
NODE_ENV=development

# ---------------------------------------------------------------------------
# OAuth (Plan 04) — Apple "Sign in with Apple" + Google OAuth Web client
# ---------------------------------------------------------------------------
#
# Apple Service ID: register at https://developer.apple.com/account/resources/identifiers
# → "Services IDs" under your Team. Configure "Sign In with Apple" capability
# and add the production Return URL "https://risevpn.com/auth/callback?provider=apple".
APPLE_SERVICE_ID=services.risevpn.web

# Must EXACTLY match a Return URL registered for the Service ID above.
APPLE_REDIRECT_URI=https://risevpn.com/auth/callback?provider=apple

# Google OAuth Web client: create at https://console.cloud.google.com/apis/credentials
# → "+ CREATE CREDENTIALS" → "OAuth client ID" → Application type: "Web application".
# Copy the resulting Client ID (ends in ".apps.googleusercontent.com").
# Must match Phase 2 backend's GOOGLE_CLIENT_ID_WEB so the verifier accepts the audience.
GOOGLE_CLIENT_ID_WEB=your-google-web-client-id.apps.googleusercontent.com

# Must match an "Authorized redirect URI" registered on the Web client above.
GOOGLE_REDIRECT_URI=https://risevpn.com/auth/callback?provider=google

# Landing's public origin (no trailing slash). Used for absolute redirect_uri
# construction and any future absolute-URL needs.
APP_URL=https://risevpn.com
