# Local-dev overrides. Copy to .env.local (uncommitted) and adjust values.
# Local Go API typically runs on :8080.
BACKEND_API_URL=http://localhost:8080

# Any non-empty string works for local dev; constant-time compare is still applied.
REVALIDATE_SECRET=local-dev-secret-do-not-use-in-prod

# Empty = host-only cookies on localhost (works for cross-port dev).
COOKIE_DOMAIN=

# Standard Next.js
NODE_ENV=development

# ---------------------------------------------------------------------------
# OAuth (Plan 04) — Apple "Sign in with Apple" + Google OAuth Web client
# ---------------------------------------------------------------------------
#
# Apple does NOT issue Sign-In-with-Apple tokens to non-https / non-public origins,
# so for purely local dev you typically use a separate Apple Service ID + Return URL
# pointing at a tunnel (e.g., ngrok https URL) OR rely on the staging Service ID.
APPLE_SERVICE_ID=services.risevpn.web.dev
APPLE_REDIRECT_URI=http://localhost:3000/auth/callback?provider=apple

# Google permits localhost as an "Authorized redirect URI" on the Web client.
# Create a separate dev Web OAuth client at https://console.cloud.google.com/apis/credentials.
GOOGLE_CLIENT_ID_WEB=your-dev-google-web-client-id.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback?provider=google

# Landing's public origin for local dev (no trailing slash).
APP_URL=http://localhost:3000
